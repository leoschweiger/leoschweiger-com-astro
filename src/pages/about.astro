---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";
import { aboutMeLong, aboutMeShort } from "../scripts/config.js";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import portraitImage from "../media/portrait-leo-schweiger.webp";
import { email, links } from "../scripts/config.js";
import "../styles/about.css";
---

<Layout
    title="about"
    topId="leo"
    ogImage={portraitImage.src}
    ogDesc={aboutMeShort}
>
    <div class="smallspace pdf"></div>
    <p class="pdflinks pdf">
        <a href={links["leoschweiger.com"]}> www.leoschweiger.com </a>
        <br />
        <a href={links[email]}> {email} </a>
        <br />
        <a href={links["github"]}> github </a>
        <br />
        <a href={links["linked in"]}> linked in </a>
    </p>
    <section>
        <div class="space"></div>

        <h1 class="nopdf">über mich</h1>

        <p class="bigtext nopdf" set:html={aboutMeLong} />

        <div class="imagekeepaspect nopdf">
            <Picture src={portraitImage} alt="leo schweiger porträt" />
        </div>

        <div class="cols bottom c12 pdf">
            <div class="imagekeepaspect">
                <Picture src={portraitImage} alt="leo schweiger porträt" />
            </div>
            <div class="bigtext">
                <h1>leo schweiger</h1>
                <h2>Softwareentwickler</h2>
            </div>
        </div>

        <hr class="pdf" />
        <hr />

        <div class="cols c12 pdf">
            <h3 class="">Über mich</h3>
            <p class="" set:html={aboutMeLong + "<br /> <br /> "} />
        </div>

        <hr />

        <div class="cols c12">
            <h3 class="">Erfahrung</h3>

            <p>
                <ExperienceEntry
                    from={2026}
                    to={"heute"}
                    company="Second Stage Studio"
                    position="freiberuflicher Spieleprogrammierer"
                    companyKind="Spielestudio"
                    link="https://secondstage.studio/"
                    doing="UI-Systeme, Menüs, Steuerung & Einstellungen für <a href='https://store.steampowered.com/app/4191250/Sprint_City/' target='_blank' rel='noopener noreferrer'>Sprint City</a> in Defold"
                />
                <ExperienceEntry
                    from={2025}
                    company="Second Stage Studio"
                    position="Spieleprogrammierer-Praktikant (4 Monate)"
                    companyKind="Spielestudio"
                    link="https://secondstage.studio/"
                    doing="UI-Systeme, Menüs, Shader für <a href='https://store.steampowered.com/app/4191250/Sprint_City/' target='_blank' rel='noopener noreferrer'>Sprint City</a> in Defold"
                />
                <ExperienceEntry
                    from={2024}
                    to={2025}
                    company="FH Salzburg"
                    position="Tutor"
                    companyKind="Einführung in die Programmierung"
                    link="https://www.fh-salzburg.ac.at/en/study/ct/multimediatechnology-bachelor"
                    doing="Betreuung von Erstsemesterstudierenden in Programmiergrundlagen"
                />
                <ExperienceEntry
                    from={2024}
                    company="Buffactory Media GmbH"
                    position="Praktikant für kreative Werbeentwicklung"
                    companyKind="Werbeagentur"
                    link="https://buffactory.com/"
                    doing="Gestaltung von Online-Werbung"
                />
                <span class="nopdf">
                    <ExperienceEntry
                        from={2022}
                        company="Target Group Publishing GmbH"
                        position="Praktikant für Editorial Design"
                        companyKind="Verlagsagentur"
                        link="http://www.target-group.at/"
                        doing="Gestaltung von Layouts für Magazine und Printanzeigen"
                    />
                </span>
                <span class="nopdf">
                    <ExperienceEntry
                        from={2021}
                        company="Mediasquad GmbH"
                        position="VR-Entwickler-Praktikant"
                        companyKind="Studio für AR/VR-Apps"
                        link="https://www.msq.at/"
                        doing="Entwicklung eines Prototyps für ein VR-Puzzlespiel"
                    />
                </span>
                <span class="nopdf">
                    <ExperienceEntry
                        from={2020}
                        company="Spectrum Advertising Agency GmbH"
                        position="Praktikant für Corporate Design"
                        companyKind="Marketingagentur"
                        link="https://www.spectrum.at/"
                        doing="Erstellung von Grafiken und Werbemitteln"
                    />
                </span>
            </p>
        </div>

        <hr />

        <div class="cols c12">
            <h3 class="">Ausbildung</h3>
            <p>
                <ExperienceEntry
                    from={2023}
                    to={2026}
                    company="FH Salzburg"
                    position="Bachelorstudium MultiMediaTechnology"
                    companyKind=""
                    link="https://www.fh-salzburg.ac.at/en/study/ct/multimediatechnology-bachelor"
                    doing="Spieleentwicklung und Augmented Reality"
                />
                <ExperienceEntry
                    from={2017}
                    to={2022}
                    company="HTL Bau und Design"
                    position=""
                    companyKind="Höhere Technische Lehranstalt"
                    link="https://www.htl-ibk.at/"
                    doing="Schwerpunkt auf Grafikdesign und Marketing"
                />
            </p>
        </div>

        <hr />

        <div class="cols c12">
            <h3 class="">Fähigkeiten</h3>
            <p>
                › C# als Hauptsprache, solide Kenntnisse in C++ und Lua <br />
                › erfahrener Unity-Entwickler <br />
                › zusätzliche Erfahrung mit Defold und Unreal Engine <br />
                › Schwerpunkt auf Spielesysteme, Tooling und UI-Programmierung <br
                />
                › Nebenerfahrung in Webentwicklung, Astro und Go <br />
            </p>
        </div>
        <div class="space pdf"></div>
    </section>
</Layout>
